" ===========================================
"            基础 Vim 设置 (Windows 适配版)
" ===========================================

" Windows Terminal/现代终端)
if has('termguicolors')
    set termguicolors
endif

" 设置字体和大小（Windows）
" set guifont=Microsoft_YaHei_Mono:h16
" set guifont=JetBrains_Mono:h16,LXGW_WenKai_Mono:h16
" set guifont=LXGW_WenKai_Mono:h16
set guifont=JetBrains_Maple_Mono:h16
" set guifont=Cascadia_Code:h16

" set guifont=Microsoft\ YaHei\ Mono:h18 

" 启用行号显示
set number
" 启用相对行号显示 (方便 hjkl 配合数字移动)
set relativenumber

" 设置滚动偏移量，确保光标周围总有上下文可见
set scrolloff=5

" 启用增量搜索，实时高亮匹配结果
set incsearch
" 搜索时忽略大小写
set ignorecase
" 搜索时智能大小写 (如果有大写字母则区分大小写)
set smartcase

" 设置 Tab 键和缩进的宽度为 4 个空格
set tabstop=4

set shiftwidth=4
" 将 Tab 转换为空格
set expandtab
" 启用自动缩进
set autoindent
" 启用智能缩进
set smartindent

"以下三行关闭响铃，也关闭闪烁
set noerrorbells
set novisualbell
set vb t_vb=

" 高亮显示光标所在行
set cursorline

" 允许退格键删除任何字符 (包括自动缩进、行尾符等)
set backspace=indent,eol,start,

" Windows 特定设置
" 设置编码为 UTF-8
set encoding=utf-8
set fileencoding=utf-8
" 设置文件格式为 Unix 风格 (避免换行符问题)
set fileformat=unix
" 启用语法高亮
syntax on
" 启用文件类型检测和插件
filetype plugin on

" ===========================================
